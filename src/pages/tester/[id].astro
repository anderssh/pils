---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResultsTable from "../../components/ResultsTable.astro";
import { cardImages } from "../../data/cardImages";
export async function getStaticPaths() {
  const entries = await getCollection("tester");
  return entries.map((entry) => ({ params: { id: entry.id } }));
}
const entry = await getEntry("tester", Astro.params.id!);
if (!entry) return Astro.redirect(`${import.meta.env.BASE_URL}tester/`);
const d = entry.data;
const winner = [...d.results].sort((a, b) => b.score - a.score)[0];
const heroImage = cardImages[entry.id];
const photographedBeers = d.results.filter((beer) => beer.image);
const beerImagePaths = new Set(photographedBeers.map((beer) => beer.image));
const supplementaryGallery = d.gallery.filter((src) => !beerImagePaths.has(src));
---
<BaseLayout title={d.title} description={`${d.title}: ${d.results.length} øl testet${d.place ? ` i ${d.place}` : ""}.`}>
  <article class="test-page">
    <header class="test-hero">
      <a class="back-link" href={`${import.meta.env.BASE_URL}tester/`}>← Alle tester</a>
      <div class:list={["test-hero-main", { "no-image": !heroImage }]}>
        <div class="test-hero-copy"><p class="kicker">{d.place || "Øltest"} · {d.year}</p><h1>{d.title}</h1><dl><div><dt>Vinner</dt><dd>{winner.name}</dd></div><div><dt>Resultat</dt><dd>{winner.score.toLocaleString("nb-NO")} lepper</dd></div><div><dt>Antall øl</dt><dd>{d.results.length}</dd></div></dl></div>
        {heroImage && <img src={`${import.meta.env.BASE_URL}${heroImage.src}`} alt="" width={heroImage.width} height={heroImage.height} fetchpriority="high" decoding="async" />}
      </div>
    </header>
    {(d.intro.length > 0 || d.participants.length > 0) && <section class="test-intro section-shell"><div>{d.intro.map((p, index) => <p class:list={{ "intro-lead": index === 0 }}>{p}</p>)}{d.activities.length > 0 && <div class="activities"><p class="kicker">De ølympiske lekene</p><ol>{d.activities.map((item) => <li>{item}</li>)}</ol></div>}</div>{d.participants.length > 0 && <aside><p class="kicker">Testpanelet</p><ul>{d.participants.map((p) => <li>{p}</li>)}</ul></aside>}</section>}
    {photographedBeers.length > 0 && <section class="beer-gallery section-shell"><div class="compact-heading"><div><p class="kicker">Ølene</p><h2>Fra kveldens test</h2></div><p>{photographedBeers.length} av {d.results.length} øl fotografert</p></div><div class="beer-gallery-grid">{photographedBeers.map((beer) => <figure><img src={`${import.meta.env.BASE_URL}${beer.image!.slice(1)}`} alt={`${beer.name}${beer.brewery ? ` fra ${beer.brewery}` : ""}`} loading="lazy" decoding="async" /><figcaption><strong>{beer.name}</strong>{beer.brewery && <span>{beer.brewery}</span>}</figcaption></figure>)}</div></section>}
    {supplementaryGallery.length > 0 && <section class="gallery section-shell"><div class="compact-heading"><div><p class="kicker">Bilder</p><h2>{d.galleryTitle}</h2>{d.galleryNote && <p class="gallery-note">{d.galleryNote}</p>}</div></div><div class="gallery-grid">{supplementaryGallery.map((src, i) => <img src={`${import.meta.env.BASE_URL}${src.slice(1)}`} alt={`Fra ${d.title}, bilde ${i + 1}`} loading="lazy" decoding="async" />)}</div></section>}
    <section class="results section-shell"><div class="compact-heading"><div><p class="kicker">Resultater</p><h2>Rangeringen</h2></div><p>{d.results.length} øl · sortert etter antall lepper</p></div><ResultsTable results={d.results} /></section>
  </article>
</BaseLayout>
