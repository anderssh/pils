---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import TestCard from "../components/TestCard.astro";
const tests = (await getCollection("tester")).sort((a, b) => b.data.year - a.data.year);
const latest = tests[0];
const total = tests.reduce((sum, test) => sum + test.data.results.length, 0);
---
<BaseLayout>
  <section class="home-hero">
    <div class="home-hero-copy">
      <p class="kicker">Etablert 2018 · {tests.length} tester · {total} vurderinger</p>
      <h1>Vi har hatt mange tester. Les om dem.</h1>
      <a class="primary-link" href={`${import.meta.env.BASE_URL}tester/`}>Se alle testene <span>→</span></a>
    </div>
    <figure><img src={`${import.meta.env.BASE_URL}images/site/hero.jpg`} alt="To medlemmer av Ølsmakerorkesteret skåler" /></figure>
  </section>
  <section class="home-about section-shell">
    <p class="kicker">Om oss</p>
    <div>
      <h2>Et testpanel med sterk øl og enda sterkere meninger.</h2>
      <div><p>Ølsmakerorkesteret har testet, rangert og diskutert øl siden 2018. Resultatet måles i lepper.</p><a class="plain-link" href={`${import.meta.env.BASE_URL}om/`}>Mer om oss →</a></div>
    </div>
  </section>
  <section class="latest section-shell">
    <div class="section-title"><p class="kicker">Siste test</p></div>
    <TestCard entry={latest} featured />
  </section>
  <section class="archive-preview section-shell">
    <div class="section-title"><h2>Tidligere tester</h2></div>
    <div class="card-grid">{tests.slice(1, 4).map((entry) => <TestCard entry={entry} />)}</div>
    <a class="plain-link" href={`${import.meta.env.BASE_URL}tester/`}>Se alle testene →</a>
  </section>
</BaseLayout>
